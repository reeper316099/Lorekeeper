{
  "name": "lorekeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b packages/shared packages/server && tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop",
    "guard": "node scripts/check-no-spreadsheets.mjs",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "dev:server": "tsx watch packages/server/src/dev.ts",
    "dev:web": "npm run dev -w @lorekeeper/web",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "prepare": "simple-git-hooks",
    "build:desktop": "npm run dist -w @lorekeeper/desktop",
    "dev:desktop": "concurrently -k -n web,app \"npm:dev:web\" \"wait-on tcp:127.0.0.1:5173 && npm run bundle:dev -w @lorekeeper/desktop && npm run dev -w @lorekeeper/desktop\"",
    "e2e": "npm run build -w @lorekeeper/desktop && playwright test",
    "perf": "tsx scripts/perf.ts",
    "screenshots": "npm run build -w @lorekeeper/desktop && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-no-spreadsheets.mjs --staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
