{
  "name": "lorekeeper",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b packages/shared && tsc --noEmit -p apps/web",
    "guard": "node scripts/check-no-spreadsheets.mjs",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "go run -C go ./cmd/server",
    "dev:web": "npm run dev -w @lorekeeper/web",
    "prepare": "simple-git-hooks",
    "build:desktop": "sh go/build-desktop.sh",
    "build:e2e": "npm run build -w @lorekeeper/web && go build -C go -o ../release-go/lorekeeper-server ./cmd/server",
    "e2e": "npm run build:e2e && playwright test",
    "screenshots": "npm run build:e2e && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "go:test": "go test -C go ./...",
    "verify": "npm run lint && npm run typecheck && npm test && npm run go:test && npm run e2e"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-no-spreadsheets.mjs --staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "exceljs": "^4.4.0",
    "globals": "^17.13.0",
    "iconv-lite": "^0.7.3",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
